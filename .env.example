# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port configuration (default 3000)
PORT=3000

# Backend Email Service Configuration (for real OTP dispatch to Gmail)
# For Gmail: Use smtp.gmail.com, port 587 (or 465), your Gmail address, and a 16-character Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smartlib.alliance.portal@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="SmartLib - Alliance University <smartlib.alliance.portal@gmail.com>"

# Optional Resend API key fallback if using Resend for email
RESEND_API_KEY=""
RESEND_FROM="SmartLib Alliance <onboarding@resend.dev>"
